###########################################################
## Variables de entorno (Environment Variables)
###########################################################
## ADVERTENCIA: Si cambias el nombre de las variables, 
## asegúrate de actualizar el archivo docker-compose.yml
## y puede que tengas que eliminar los contenedores y 
## volúmenes existentes para que los cambios surtan efecto.
###########################################################

#### Odoo
ODOO_USER=odoo
ODOO_PASSWORD=odoo_pass

#### Odoo PostgreSQL
ODOO_POSTGRES_PASSWORD=odoo_pass
ODOO_POSTGRES_USER=odoo

#### SuiteCRM
SUITECRM_DATABASE_NAME=suitecrm_db
SUITECRM_DATABASE_USER=suitecrm_user
SUITECRM_DATABASE_PASSWORD=suitecrm_pass

#### SuiteCRM MariaDB
SUITECRM_MARIADB_DATABASE=suitecrm_db
SUITECRM_MARIADB_USER=suitecrm_user
SUITECRM_MARIADB_PASSWORD=suitecrm_pass
SUITECRM_MARIADB_ROOT_PASSWORD=root_pass

#### Bonita
BONITA_DB_PORT=5432
BONITA_DB_NAME=bonita
BONITA_DB_USER=bonita
BONITA_DB_PASS=bpm
BONITA_BIZ_DB_NAME=business_data
BONITA_BIZ_DB_USER=business_data
BONITA_BIZ_DB_PASS=bpm

#### Bonita PostgreSQL
BONITA_POSTGRES_PASSWORD=my-secret-pw

#### pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@sie.com
PGADMIN_DEFAULT_PASSWORD=admin

#### phpMyAdmin
PHPMYADMIN_PMA_PORT=3306
PHPMYADMIN_UPLOAD_LIMIT=64M

#### Acceso por API

## Odoo
ODOO_URL=http://odoo:8069
ODOO_DB=SIE-test
# Para XML-RPC
ODOO_API_USER=fastapi@sie-test.es
ODOO_API_PASSWORD=fastapi
# Para JSON-2
ODOO_API_KEY=98bccfeeb643771eec9f8b320427cc4192a7da9c

## SuiteCRM
SUITECRM_URL=http://suitecrm
SUITECRM_CLIENT_ID=099f71b8-f8d8-46c9-98a0-9616cdee63e8
SUITECRM_CLIENT_SECRET=SIE-API-SECRET-KEY

## Bonita
BONITA_URL=http://bonita:8080
BONITA_USERNAME=install
BONITA_PASSWORD=install
#BONITA_USERNAME=maria
#BONITA_PASSWORD=bpm

### Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
